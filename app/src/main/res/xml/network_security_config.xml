<?xml version="1.0" encoding="utf-8"?>
<!--
  RELEASE (and every non-debug build) network security policy.

  PaySync Gateway sends the webhook secret + HMAC-signed dispatches to the
  user-configured backend. Cleartext HTTP would leak both, so it is disabled
  here. Local plaintext-HTTP testing (http://192.168.x.x:8000) is only
  possible in DEBUG builds, which override this file via
  app/src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
