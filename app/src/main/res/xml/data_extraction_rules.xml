<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules (cloud backup + device-to-device).
  Backup is disabled app-wide (android:allowBackup=false); these exclusions
  are the second line of defense for the Room DB (wallet SMS bodies) and
  shared prefs (backend secret) on any transfer path.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
