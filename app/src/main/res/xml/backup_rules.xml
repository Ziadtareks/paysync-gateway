<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup is disabled app-wide (android:allowBackup=false): the Room database
  holds full wallet SMS bodies and the encrypted prefs hold the backend
  secret — neither belongs in cloud backups or device transfers, and a
  restored EncryptedSharedPreferences file is undecryptable anyway (its
  master key lives in the Android Keystore of the original device).
  This file is retained so the manifest reference stays valid on all API
  levels; every domain is excluded defensively.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
